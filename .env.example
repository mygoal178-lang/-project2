# OrderFlow environment
# NEVER commit real secrets. NEVER put service-role keys in VITE_* vars.

# Required for production auth + database (client)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Explicit demo mode when Supabase IS configured (default: off)
# VITE_ENABLE_DEMO_MODE=true

# Server-only (Vercel / API routes — do NOT prefix with VITE_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CREDENTIALS_ENCRYPTION_KEY=
ALLOWED_ORIGINS=https://your-app.vercel.app

# Optional payments
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# APP_URL=https://your-app.vercel.app
